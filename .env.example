# Copy to `.env` for local overrides (never commit real secrets).
# Docker Compose defaults match these demo values.

# Backend
DB_URL=jdbc:postgresql://localhost:5432/live_staffing
DB_USER=oloodi
DB_PASSWORD=oloodi
SPRING_PROFILES_ACTIVE=local

# Frontend (dev). Empty = Vite proxies /api → localhost:8080.
# For Playwright / direct EventSource against the API:
# VITE_API_BASE_URL=http://127.0.0.1:8080

# E2E / measurements
# E2E_API_URL=http://127.0.0.1:8080
# E2E_BASE_URL=http://127.0.0.1:5173
